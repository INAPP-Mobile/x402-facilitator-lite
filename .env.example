# x402 Facilitator Lite — Environment Variables
# Copy this to .env for local dev. In Railway, set these as service variables.

# Required: EVM private key (0x-prefixed) used as gas wallet for settlement
# Generate a new one: `cast wallet new` or use any wallet. This is NOT your payTo.
EVM_PRIVATE_KEY=0x...

# Optional: Your USDC receiver address (where settled funds go)
# If omitted, settlement will fail but verification still works.
EVM_PAY_TO_ADDRESS=0x...

# Optional: RPC URL for Base mainnet (defaults to public Base RPC)
# For production, use a private RPC (Alchemy, Infura, etc.)
RPC_URL=https://mainnet.base.org

# Optional: RPC URL for Base Sepolia (testnet)
RPC_URL_SEPOLIA=https://sepolia.base.org

# Server port (default 8080, Railway sets this automatically)
PORT=8080
